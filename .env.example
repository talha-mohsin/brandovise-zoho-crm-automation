# Zoho data centre endpoints — must match where your Zoho account was created.
# .com (US) shown here; use .eu / .in / .com.au / .jp as appropriate.
ZOHO_ACCOUNTS_URL=
ZOHO_API_DOMAIN=

# From a Server-based Application client in the Zoho API Console
# (https://api-console.zoho.com), scopes: ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Long-lived refresh token obtained once via the OAuth consent flow; the
# server exchanges it for short-lived access tokens on every request.
ZOHO_REFRESH_TOKEN=

# Optional overrides
ZOHO_API_VERSION=
ZOHO_CONTRACT_MODULE_API_NAME=
